# LicenseSaathi — required environment variable NAMES only (no values).
#
# Real values live on Vercel, scoped per environment (Production / Preview /
# Development), and are NEVER committed. Copy this file to .env.local for local
# development and fill in values that point at a NON-production Supabase project
# (see docs/feature-flags-and-staging.md — local/preview must not write to the
# production DB). .env.local is gitignored.

# --- Supabase (ticket 02) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # server-only — never prefix with NEXT_PUBLIC_

# --- Mixpanel (ticket 13) ---
NEXT_PUBLIC_MIXPANEL_TOKEN=

# --- Feature flags: "ship dark" (unset = OFF). Set to exactly "true" to enable.
# Server-side flags; gate server routes/logic. See docs/feature-flags-and-staging.md.
FEATURE_SAVE_CHECKLIST=           # Phone-OTP + save checklist (ticket 10)
FEATURE_ADMIN=                    # Admin CRUD panel (ticket 09)
FEATURE_FIELD_NOTES=              # Community field-notes display (ticket 08)
FEATURE_REMINDERS=                # Reminder email + field-note capture (14, 15)
